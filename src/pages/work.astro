---
import '@fontsource/dela-gothic-one/japanese-400.css';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SpineNav from '../components/SpineNav.astro';

import { work } from '../data/work';

// Flat stand-ins for the project imagery: one tone per frame, no pictures.
const tones = [
  { bg: 'oklch(0.33 0.01 75)', fg: 'oklch(0.95 0.014 85)' },
  { bg: 'oklch(0.95 0.014 85)', fg: 'oklch(0.21 0.006 75)' },
  { bg: 'oklch(0.41 0.011 75)', fg: 'oklch(0.95 0.014 85)' },
];
const items = work.map((p, i) => ({ ...p, ...tones[i % tones.length] }));
---

<Base title="Work · Kaiden Bell" theme="dark">
  <main class="work" id="work">
    <SpineNav current="work" lift />

    <section class="reel" id="reel" style={`--n:${items.length}`} aria-label="Featured work">
      <h1 class="sr-only">Work</h1>
      <div class="stage" id="stage">
        <div class="rail" data-rail>
          {items.map((p, i) => (
            <button
              class="frame"
              type="button"
              data-i={i}
              aria-label={`Open ${p.name}`}
              style={`--bg:${p.bg}`}
            >
              <span class="fill"></span>
              <span class="shade"></span>
            </button>
          ))}
        </div>

        <div class="titles" aria-hidden="true">
          {items.map((p) => (
            <div class="title" data-title style={`--len:${p.name.length};--fg:${p.fg}`}>
              <p class="kicker">{p.category}</p>
              <p class="name">{p.name}</p>
              <span class="go"><Arrow size={22} /></span>
            </div>
          ))}
        </div>

        <nav class="thumbs" aria-label="Projects">
          <span class="mark" data-mark aria-hidden="true"></span>
          {items.map((p, i) => (
            <button type="button" class="thumb" data-thumb={i} aria-label={`Go to ${p.name}`} style={`--bg:${p.bg}`}></button>
          ))}
        </nav>
        <p class="sr-only" aria-live="polite" data-live></p>
      </div>
    </section>


    <dialog class="story" id="story" aria-labelledby="story-title">
      <div class="story-sheet">
        <button class="story-close" type="button" data-close>Close <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" /></svg></button>
        <div class="story-hero" data-hero></div>
        <div class="story-copy">
          <p class="story-meta" data-s-meta></p>
          <h2 class="story-title" id="story-title" data-s-title></h2>
          <p class="story-line" data-s-line></p>
          <p class="story-stack" data-s-stack></p>
          <a class="cta cta-ink" data-s-link href="#" rel="noopener">View it <span class="cta-arrow"><Arrow size={16} /></span></a>
        </div>
      </div>
    </dialog>
  </main>
</Base>

<script define:vars={{ items }}>
  const reel = document.getElementById('reel');
  const stage = document.getElementById('stage');
  const rail = stage.querySelector('[data-rail]');
  const frames = [...stage.querySelectorAll('.frame')];
  const titles = [...stage.querySelectorAll('[data-title]')];
  const thumbs = [...stage.querySelectorAll('[data-thumb]')];
  const mark = stage.querySelector('[data-mark]');
  const live = stage.querySelector('[data-live]');
  const story = document.getElementById('story');
  const mainEl = document.getElementById('work');
  const N = items.length;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const smoother = (f) => f * f * f * (f * (f * 6 - 15) + 10);

  // Same idea as the reference: native scroll, but each frame dwells at rest and travels between.
  const paced = (t) => {
    const k = Math.min(Math.floor(t), N - 1);
    return k + smoother(clamp(t - k, 0, 1));
  };

  const TILT = -7; // the whole rail leans, so frames travel along a slanted axis
  const sin = Math.sin((TILT * Math.PI) / 180);
  const cos = Math.cos((TILT * Math.PI) / 180);
  let target = 0, cur = 0, active = -1, raf = 0;

  const readTarget = () => {
    const r = reel.getBoundingClientRect();
    target = paced(clamp(-r.top / Math.max(1, r.height - innerHeight), 0, 1) * (N - 1));
  };

  const layout = () => {
    const H = stage.clientHeight;
    const fh = frames[0].offsetHeight;
    const pitch = fh + H * 0.11;
    const R = Math.max(2200, H * 2.6); // radius of the cylinder the frames are wrapped on

    frames.forEach((el, i) => {
      const d = i - cur;
      const a = Math.abs(d);
      if (a > 1.6) { el.style.visibility = 'hidden'; return; }
      const phi = (d * pitch) / R;
      const y = R * Math.sin(phi);
      const z = -R * (1 - Math.cos(phi));
      el.style.visibility = '';
      el.style.transform = `translate(-50%,-50%) translate3d(0,${y.toFixed(1)}px,${z.toFixed(1)}px) rotateX(${(phi * 57.2958).toFixed(2)}deg)`;
      el.style.setProperty('--dim', clamp(a * 0.9, 0, 0.75).toFixed(3));
      el.style.setProperty('--par', `${(d * -14).toFixed(2)}%`);
    });

    titles.forEach((el, i) => {
      const d = i - cur;
      const a = Math.abs(d);
      const y = d * pitch;
      // The title stays upright and rides the frame's centre along the leaning axis.
      const px = rail.offsetLeft + rail.clientWidth / 2 - y * sin;
      const py = H / 2 + y * cos;
      el.style.visibility = a > 0.75 ? 'hidden' : '';
      el.style.opacity = clamp(1 - Math.max(0, a - 0.12) * 1.7, 0, 1).toFixed(3);
      el.style.transform = `translate3d(${px.toFixed(1)}px,${py.toFixed(1)}px,0) translate(-50%,-50%)`;
    });

    mark.style.transform = `translateY(${(cur * 20).toFixed(2)}px)`;

    const idx = clamp(Math.round(cur), 0, N - 1);
    if (idx !== active) {
      active = idx;
      live.textContent = `${items[idx].name}, ${idx + 1} of ${N}`;
      frames.forEach((f, i) => { f.tabIndex = i === idx ? 0 : -1; f.dataset.front = i === idx ? '1' : ''; });
      thumbs.forEach((t, i) => t.setAttribute('aria-current', i === idx ? 'true' : 'false'));
    }
  };

  const tick = () => {
    raf = 0;
    const diff = target - cur;
    cur = reduce.matches || Math.abs(diff) < 0.0008 ? target : cur + diff * 0.1;
    layout();
    if (cur !== target) raf = requestAnimationFrame(tick);
  };
  const kick = () => { readTarget(); if (!raf) raf = requestAnimationFrame(tick); };
  addEventListener('scroll', kick, { passive: true });
  addEventListener('resize', kick);

  const goTo = (i, instant) => {
    const r = reel.getBoundingClientRect();
    const top = scrollY + r.top + (i / (N - 1)) * (r.height - innerHeight);
    scrollTo({ top, behavior: instant || reduce.matches ? 'auto' : 'smooth' });
  };
  thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));

  // Hovering the front frame wakes its arrow.
  stage.addEventListener('pointermove', (e) => {
    const f = e.target.closest?.('.frame');
    stage.classList.toggle('hot', !!f && f.dataset.front === '1');
  });
  stage.addEventListener('pointerleave', () => stage.classList.remove('hot'));

  // --- Story
  let opener = null;
  const hero = story.querySelector('[data-hero]');
  const inert = (v) => mainEl.querySelectorAll('.spine-nav, .reel').forEach((n) => (n.inert = v));
  const open = (i, from) => {
    const it = items[i];
    opener = from;
    hero.style.setProperty('--bg', it.bg);
    story.querySelector('[data-s-meta]').textContent = `${it.category} · ${it.year}`;
    story.querySelector('[data-s-title]').textContent = it.name;
    story.querySelector('[data-s-line]').textContent = it.line;
    story.querySelector('[data-s-stack]').textContent = it.stack.join(' · ');
    story.querySelector('[data-s-link]').href = it.href;
    inert(true);
    document.documentElement.style.overflow = 'hidden';
    story.showModal();
    requestAnimationFrame(() => story.classList.add('shown'));
    story.querySelector('[data-close]').focus();
  };
  const close = () => {
    story.classList.remove('shown');
    setTimeout(() => {
      story.close();
      inert(false);
      document.documentElement.style.overflow = '';
      opener?.focus();
    }, reduce.matches ? 0 : 520);
  };
  story.querySelector('[data-close]').addEventListener('click', close);
  story.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  frames.forEach((el, i) => el.addEventListener('click', () => (i === active ? open(i, el) : goTo(i))));

  addEventListener('keydown', (e) => {
    if (story.open) return;
    const r = reel.getBoundingClientRect();
    if (r.top > innerHeight * 0.5 || r.bottom < innerHeight * 0.5) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); goTo(Math.min(N - 1, active + 1)); }
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); goTo(Math.max(0, active - 1)); }
  });

  readTarget();
  cur = target;
  layout();
  const hashIdx = items.findIndex((p) => p.id === location.hash.slice(1));
  if (hashIdx >= 0) requestAnimationFrame(() => goTo(hashIdx, true));
</script>

<style>
  .work {
    --spine: clamp(2.5rem, 5vw, 4.5rem);
    --edge: clamp(1rem, 3vw, 2.75rem);
    position: relative;
    isolation: isolate;
    background: var(--charcoal);
    color: var(--bone);
    padding-left: var(--spine);
  }

  /* Fixed furniture: the reel is the only thing on the page; navigation lives in the spine. */

  .reel {
    height: calc(var(--n) * 130svh);
    margin-left: calc(var(--spine) * -1);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    padding-left: var(--spine);
    contain: layout paint;
  }

  /* The rail leans, and each frame is wrapped on a cylinder inside it. */
  .rail {
    position: absolute;
    inset: 0 0 0 var(--spine);
    perspective: 1900px;
    perspective-origin: 50% 50%;
    transform: rotate(-7deg);
    transform-style: preserve-3d;
  }
  .frame {
    --dim: 0;
    --par: 0%;
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(76vw, 1120px);
    height: min(76svh, 62vw, 760px);
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--bg);
    cursor: pointer;
    will-change: transform;
  }
  /* A soft light drifting across the flat colour gives the frame something to parallax against. */
  .fill {
    position: absolute;
    inset: -30% 0;
    translate: 0 var(--par);
    background: radial-gradient(60% 40% at 50% 50%, oklch(1 0 0 / 0.1), transparent 70%);
  }
  .shade {
    position: absolute;
    inset: 0;
    background: oklch(0.14 0.006 75);
    opacity: var(--dim);
    pointer-events: none;
  }

  .titles {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
  }
  .title {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    width: max-content;
    color: var(--fg);
    text-align: center;
    will-change: transform, opacity;
  }
  .kicker {
    margin: 0;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .name {
    margin: 0;
    font-weight: 900;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: min(16vw, 28svh, calc(54vw / (var(--len) * 0.42)));
    line-height: 0.8;
    letter-spacing: -0.02em;
    word-spacing: 0.14em;
    white-space: nowrap;
  }
  .go {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-top: 0.4rem;
    border-radius: 50%;
    background: var(--charcoal);
    color: var(--bone);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      scale 0.5s var(--ease-out);
  }
  .hot .go {
    scale: 1.14;
    background: var(--gold);
    color: var(--charcoal);
  }

  /* Index rail on the right: one chip per frame, one outline that travels. */
  .thumbs {
    position: absolute;
    right: var(--edge);
    bottom: clamp(1rem, 4svh, 2.5rem);
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 4px;
  }
  .thumb {
    width: 28px;
    height: 12px;
    padding: 0;
    border: 1px solid oklch(0.95 0.014 85 / 0.5);
    background: var(--bg);
    cursor: pointer;
    position: relative;
  }
  .thumb::after {
    content: '';
    position: absolute;
    inset: -10px -6px;
  }
  .mark {
    position: absolute;
    left: -2px;
    top: 0;
    width: 36px;
    height: 20px;
    border: 1px solid var(--bone);
    pointer-events: none;
    will-change: transform;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0.55rem 0.55rem 1.25rem;
    background: var(--bone);
    color: var(--charcoal);
    text-decoration: none;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cta-arrow {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    background: var(--gold);
    color: var(--charcoal);
    transition: translate 0.4s var(--ease-out);
  }
  .cta:hover .cta-arrow {
    translate: 0.25rem 0;
  }
  .cta-ink {
    background: var(--charcoal);
    color: var(--bone);
    box-shadow: 0 16px 30px -16px oklch(0.2 0.01 75 / 0.7);
  }

  /* Story: Bone Stock spread over the reel. */
  .story {
    --ink: var(--charcoal);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    color: var(--ink);
    background:
      radial-gradient(80% 70% at 55% 45%, oklch(0.97 0.01 85), transparent 75%),
      var(--bone);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  .story.shown {
    clip-path: inset(0);
  }
  .story::backdrop {
    background: oklch(0.15 0.006 75 / 0.72);
  }
  .story-sheet {
    position: relative;
    min-height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(4rem, 9svh, 6rem) var(--edge) clamp(2rem, 5svh, 3rem);
  }
  .story-hero {
    aspect-ratio: 7 / 5;
    outline: 2px solid var(--ink);
    background: var(--bg);
    box-shadow: 0 30px 60px -30px oklch(0.2 0.01 75 / 0.7);
    rotate: -2deg;
  }
  .story-copy > * {
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.7s var(--ease-out) 0.15s,
      translate 0.7s var(--ease-out) 0.15s;
  }
  .story.shown .story-copy > * {
    opacity: 1;
    translate: 0 0;
  }
  .story-meta,
  .story-stack {
    margin: 0;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .story-title {
    margin: 0.6rem 0 1.2rem;
    font-weight: 900;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: clamp(3rem, min(8vw, 14svh), 7rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .story-line {
    margin: 0 0 1.4rem;
    padding-bottom: 1.2rem;
    border-bottom: 2px solid var(--ink);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.35;
    max-width: 34ch;
  }
  .story-stack {
    margin-bottom: 1.8rem;
    font-weight: 700;
    font-stretch: 100%;
    font-size: 0.6875rem;
  }
  .story-close {
    position: absolute;
    top: clamp(0.9rem, 2.4svh, 1.6rem);
    right: var(--edge);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0 0.45rem;
    border: 0;
    border-bottom: 2px solid var(--ink);
    background: none;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .story :focus-visible {
    outline-color: var(--charcoal);
  }

  @media (max-width: 860px) {
    .frame {
      width: 84vw;
      height: 66svh;
    }
    .name {
      font-size: min(22vw, calc(70vw / (var(--len) * 0.42)));
    }
    .story-sheet {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story,
    .story-copy > * {
      transition-duration: 0.01ms;
    }
  }
</style>
