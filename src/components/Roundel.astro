---
interface Props {
  class?: string;
  id?: string;
}
const { class: className, id = 'ring' } = Astro.props;
---

<svg
  class:list={['roundel', className]}
  viewBox="0 0 200 200"
  role="img"
  aria-label="University of Nevada, Reno, Computer Science and Engineering, class of 2027"
>
  <defs>
    <path id={id} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
  </defs>
  <circle cx="100" cy="100" r="96" class="disc" />
  <circle cx="100" cy="100" r="88" class="rule" />
  <text class="ring-text"><textPath href={`#${id}`} textLength="462">UNR · COMPUTER SCIENCE &amp; ENGINEERING · CLASS OF ·</textPath></text>
  <text x="100" y="124" text-anchor="middle" class="year">’27</text>
</svg>

<style>
  .roundel {
    --r-disc: var(--charcoal);
    --r-text: var(--bone);
    --r-accent: var(--gold);
    display: block;
    width: 100%;
    height: auto;
  }
  .disc {
    fill: var(--r-disc);
  }
  .rule {
    fill: none;
    stroke: var(--r-accent);
    stroke-width: 1.5;
  }
  .ring-text {
    fill: var(--r-text);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 100%;
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .year {
    fill: var(--r-accent);
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-size: 80px;
  }
</style>
